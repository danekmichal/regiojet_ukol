	partition Dim_Letiste = calculated
		mode: import
		source =
				VAR _ValidItiner =
				    CALCULATETABLE (
				        VALUES ( dataItiner[Last id_to] ),
				        NOT ISBLANK ( dataItiner[id_letenka] )
				    )
				RETURN
				    FILTER (
				        ADDCOLUMNS (
				            SELECTCOLUMNS (
				                FILTER (
				                    datadestinace,
				                    datadestinace[id_letiste] IN _ValidItiner
				                        && NOT ISBLANK ( datadestinace[nazev] )
				                        && TRIM ( datadestinace[nazev] ) <> ""
				                        && TRIM ( datadestinace[nazev] ) <> "0"
				                        && NOT CONTAINSSTRING ( datadestinace[nazev], "&#" )
				                ),
				                "id_letiste", datadestinace[id_letiste],
				                "Letiště", datadestinace[nazev]
				            ),
				            "PocetLetenekCelkem",
				                VAR _Id = [id_letiste]
				                RETURN
				                    CALCULATE (
				                        COUNTROWS ( dataLet ),
				                        TREATAS ( { _Id }, dataItiner[Last id_to] ),
				                        NOT ISBLANK ( dataCRM[id_rezervace] )
				                    )
				        ),
				        [PocetLetenekCelkem] > 0
				    )

	annotation PBI_Id = 44d55e66f7a848b990c122d33e44f55a

