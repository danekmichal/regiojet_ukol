	column ZacatekPondeliTydne
		dataType: dateTime
		formatString: Short Date
		lineageTag: 281ffa61-943a-450e-a490-61b244fc0510
		summarizeBy: none
		isNameInferred
		sourceColumn: [ZacatekPondeliTydne]

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				VAR _ActiveMonths =
				    DISTINCT (
				        SELECTCOLUMNS (
				            FILTER ( dataCRM, NOT ISBLANK ( dataCRM[datum_rezervace] ) ),
				            "YM", YEAR ( dataCRM[datum_rezervace] ) * 100 + MONTH ( dataCRM[datum_rezervace] )
				        )
				    )
				VAR _MinDateCRM = MIN ( dataCRM[datum_rezervace] )
				VAR _MaxDateCRM = MAX ( dataCRM[datum_rezervace] )
				VAR _MinDate = DATE ( YEAR ( _MinDateCRM ), MONTH ( _MinDateCRM ), 1 )
				VAR _MaxDate = EOMONTH ( _MaxDateCRM, 0 )
				RETURN
				    FILTER (
				        ADDCOLUMNS (
				            CALENDAR ( _MinDate, _MaxDate ),
				            "Rok", YEAR ( [Date] ),
				            "CisloMesice", MONTH ( [Date] ),
				            "Mesic", FORMAT ( [Date], "MMMM", "cs-CZ" ),
				            "MesicZkracene", FORMAT ( [Date], "MMM", "cs-CZ" ),
				            "RokMesicKod", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				            "RokMesicText", FORMAT ( [Date], "yyyy-MM" ),
				            "Kvartal", "Q" & FORMAT ( [Date], "Q" ),
				            "CisloTydne", WEEKNUM ( [Date], 21 ),
				            "DenVTydnuCislo", WEEKDAY ( [Date], 2 ),
				            "DenVTydnu", FORMAT ( [Date], "dddd", "cs-CZ" ),
				            "JeVikend", IF ( WEEKDAY ( [Date], 2 ) IN { 6, 7 }, 1, 0 ),
				            "ZacatekMesice", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				            "ZacatekPondeliTydne", [Date] - WEEKDAY ( [Date], 2 ) + 1
				        ),
				        [RokMesicKod] IN _ActiveMonths
				    )

	annotation PBI_Id = 1037fe2ee2d643999e8ead9e2d6caaf7

