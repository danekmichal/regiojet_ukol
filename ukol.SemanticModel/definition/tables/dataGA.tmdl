	column 'Zdroj objednávky (Top 10)' =
			VAR _DistinctSources =
			    CALCULATE ( DISTINCTCOUNTNOBLANK ( dataGA[sessionSource] ), ALL ( dataGA ) )
			VAR _Src = COALESCE ( dataGA[sessionSource], "(not set)" )
			VAR _Med = COALESCE ( dataGA[sessionMedium], "(none)" )
			RETURN
			    IF (
			        _DistinctSources >= 10,
			        _Src,
			        IF (
			            _Med = "(none)" || _Med = "(not set)" || _Med = _Src || _Src = "(not set)",
			            _Src,
			            _Src & " (" & _Med & ")"
			        )
			    )
		dataType: string
		lineageTag: f2dc2709-510a-47b3-b962-44d1b3111af1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

